# Port d'écoute du serveur Express
PORT=5000
NODE_ENV=development

# URL publique autorisée pour CORS
FRONTEND_URL=http://localhost:3000

# Configuration Supabase Cloud (PostgreSQL & Auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Clé API Anthropic (Claude 3.5 Sonnet / Haiku pour les recommandations)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Paramètres de Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
